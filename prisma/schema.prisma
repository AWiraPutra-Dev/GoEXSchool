generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  operator
  student
}

enum UserStatus {
  active
  inactive
}

enum AccountStatus {
  imported
  registered
}

enum MemberStatus {
  active
  inactive
}

enum AttendanceStatus {
  hadir
  izin
  alpha
}

enum AchievementType {
  juara
  sertifikat
  partisipasi
  organisasi
}

enum AchievementLevel {
  sekolah
  kecamatan
  kota
  provinsi
  nasional
}

enum FeedPostType {
  announcement
  achievement
  gallery
  poll
  schedule
}

model Institution {
  id             String   @id @default(cuid())
  name           String
  npsn           String?
  address        String?
  phone          String?
  email          String?
  website        String?
  headmaster     String?
  activeYear     String   @default("2025/2026")
  activeSemester String   @default("Ganjil")
  logo           String?
  // Warna aksen tema aplikasi (hex) — diatur admin, berlaku untuk semua role
  themeColor     String?  @default("#4F46E5")
  // Lokasi sekolah untuk absensi QR berbasis lokasi (geofencing)
  latitude       Float?
  longitude      Float?
  // Radius absensi dalam meter (default 200m — batas wajar area sekolah)
  attendanceRadius Int?  @default(200)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users           User[]
  students        Student[]
  teachers        Teacher[]
  classes         Class[]
  extracurriculars Extracurricular[]
  polls           Poll[]
  newsList        News[]
  galleries       Gallery[]
  activityLogs    ActivityLog[]
  feedPosts       FeedPost[]
  schedules       Schedule[]
  articles        Article[]
  materials       ExtracurricularMaterial[]
  notifications   Notification[]
  agendas         Agenda[]
  boardPositions  BoardPosition[]

  @@map("institution")
}

model Student {
  id             String        @id @default(cuid())
  nis            String        @unique
  name           String
  class          String
  gender         String
  phone          String?
  accountStatus  AccountStatus @default(imported)
  institutionId  String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  institution       Institution       @relation(fields: [institutionId], references: [id])
  user              User?
  members           Member[]
  assessments       Assessment[]
  attendanceRecords AttendanceRecord[]
  achievements      Achievement[]

  @@map("student")
}

model User {
  id           String     @id @default(cuid())
  username     String     @unique
  passwordHash String
  name         String
  role             Role
  phone            String?
  email            String?
  // Foto profil — bisa diunggah siswa & operator ekskul (tampil di TopBar)
  avatarUrl        String?
  status           UserStatus @default(active)
  institutionId    String
  studentId        String?    @unique
  extracurricularId String?   // operator ekskul: dibatasi hanya untuk ekskul ini
  lastLogin    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  institution         Institution       @relation(fields: [institutionId], references: [id])
  student             Student?          @relation(fields: [studentId], references: [id])
  extracurricularOperator Extracurricular? @relation("ExtracurricularOperators", fields: [extracurricularId], references: [id])
  permissions         UserPermission[]
  feedComments        FeedComment[]
  feedLikes           FeedLike[]
  pollVotes           PollVote[]
  activityLogs        ActivityLog[]
  attendanceSessions  AttendanceSession[]
  pollsCreated        Poll[]            @relation("PollCreator")
  newsCreated         News[]            @relation("NewsCreator")
  articles            Article[]
  articleViews        ArticleView[]
  materialsUploaded   ExtracurricularMaterial[]
  notifications       Notification[]
  agendas             Agenda[]

  @@map("user")
}

model Teacher {
  id            String @id @default(cuid())
  nip           String @unique
  name          String
  subject       String
  phone         String?
  institutionId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution      Institution      @relation(fields: [institutionId], references: [id])
  extracurriculars Extracurricular[]

  @@map("teacher")
}

model Class {
  id            String @id @default(cuid())
  name          String
  grade         String
  major         String
  studentCount  Int    @default(0)
  homeroom      String?
  institutionId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id])

  @@map("class")
}

model Extracurricular {
  id            String  @id @default(cuid())
  name          String
  quota         Int
  scheduleInfo  String?
  description   String?
  logoUrl       String?
  institutionId String
  teacherId     String?

  // ===== Pengaturan tampilan Struktur Organisasi ekskul =====
  // mode: "cards" (buat dari aplikasi: kartu foto+nama+kelas+jabatan)
  //       | "image" (upload desain jadi, mis. dari Canva)
  structureMode     String  @default("cards")
  // URL gambar desain struktur (dipakai saat mode = image)
  structureImageUrl String?
  // Tema tampilan kartu: "indigo" | "sunset" | "forest"
  structureTheme    String  @default("indigo")

  institution Institution      @relation(fields: [institutionId], references: [id])
  teacher     Teacher?         @relation(fields: [teacherId], references: [id])
  members     Member[]
  schedules   Schedule[]
  assessments Assessment[]
  attendanceSessions AttendanceSession[]
  attendanceRecords  AttendanceRecord[]
  polls       Poll[]
  newsList    News[]
  galleries   Gallery[]
  achievements Achievement[]
  feedPosts   FeedPost[]
  materials   ExtracurricularMaterial[]
  articles    Article[]
  operators   User[]            @relation("ExtracurricularOperators")
  boardPositions BoardPosition[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("extracurricular")
}

model Member {
  id                String       @id @default(cuid())
  studentId         String
  extracurricularId String
  joinDate          DateTime     @default(now())
  status            MemberStatus @default(active)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  student        Student         @relation(fields: [studentId], references: [id])
  extracurricular Extracurricular @relation(fields: [extracurricularId], references: [id])

  @@unique([studentId, extracurricularId])
  @@map("member")
}

model Schedule {
  id                String @id @default(cuid())
  day               String
  // Tanggal pertemuan spesifik (opsional). Jika diisi → jadwal pertemuan
  // sekali waktu; jika kosong → jadwal rutin mingguan (dipakai tiap hari tsb).
  date              DateTime?
  timeStart         String
  timeEnd           String?
  coach             String
  location          String
  mandatory         Boolean @default(true)
  extracurricularId String
  institutionId     String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Titik lokasi geofence spesifik untuk pertemuan ini (diatur operator/admin).
  // Jika kosong → absensi memakai lokasi sesi QR, lalu lokasi sekolah.
  latitude  Float?
  longitude Float?
  radius    Int?    @default(200)

  extracurricular Extracurricular @relation(fields: [extracurricularId], references: [id])
  institution     Institution     @relation(fields: [institutionId], references: [id])
  records         AttendanceRecord[]

  @@map("schedule")
}

model Assessment {
  id                String   @id @default(cuid())
  score             Int
  grade             String
  notes             String?
  date              DateTime @default(now())
  studentId         String
  extracurricularId String
  createdAt         DateTime @default(now())

  student        Student         @relation(fields: [studentId], references: [id])
  extracurricular Extracurricular @relation(fields: [extracurricularId], references: [id])

  @@map("assessment")
}

model AttendanceSession {
  id                String   @id @default(cuid())
  qrToken           String   @unique
  qrExpiresAt       DateTime
  date              DateTime @default(now())
  extracurricularId String
  createdById       String
  // Lokasi geofencing absensi untuk sesi ini (diatur operator saat buat QR).
  // Radius dalam meter; null = ikuti lokasi sekolah di Pengaturan Instansi.
  latitude     Float?
  longitude    Float?
  radius       Int?     @default(200)
  locationName String?
  createdAt    DateTime @default(now())

  extracurricular Extracurricular   @relation(fields: [extracurricularId], references: [id])
  createdBy       User              @relation(fields: [createdById], references: [id])
  records         AttendanceRecord[]

  @@map("attendance_session")
}

model AttendanceRecord {
  id                String           @id @default(cuid())
  status            AttendanceStatus
  time              String?
  notes             String?
  date              DateTime         @default(now())
  studentId         String
  extracurricularId String
  sessionId         String?
  // Pertemuan (jadwal/agenda) terkait izin — izin diajukan dari kalender.
  scheduleId String?
  // Scan/foto surat izin yang diunggah siswa saat mengajukan secara digital.
  proofUrl   String?

  student        Student            @relation(fields: [studentId], references: [id])
  extracurricular Extracurricular   @relation(fields: [extracurricularId], references: [id])
  session        AttendanceSession? @relation(fields: [sessionId], references: [id])
  schedule       Schedule?          @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@map("attendance_record")
}

model Poll {
  id                String   @id @default(cuid())
  question          String
  endDate           DateTime
  active            Boolean  @default(true)
  extracurricularId String
  createdById       String
  institutionId     String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  extracurricular Extracurricular @relation(fields: [extracurricularId], references: [id])
  createdBy      User            @relation("PollCreator", fields: [createdById], references: [id])
  institution    Institution     @relation(fields: [institutionId], references: [id])
  options        PollOption[]
  votes          PollVote[]

  @@map("poll")
}

model PollOption {
  id         String @id @default(cuid())
  label      String
  votesCount Int    @default(0)
  pollId     String

  poll  Poll       @relation(fields: [pollId], references: [id])
  votes PollVote[]

  @@map("poll_option")
}

model PollVote {
  id           String   @id @default(cuid())
  pollOptionId String
  pollId       String
  userId       String
  createdAt    DateTime @default(now())

  pollOption PollOption @relation(fields: [pollOptionId], references: [id])
  poll       Poll       @relation(fields: [pollId], references: [id])
  user       User       @relation(fields: [userId], references: [id])

  @@unique([pollId, userId])
  @@map("poll_vote")
}

model News {
  id                String   @id @default(cuid())
  title             String
  content           String
  isPublic          Boolean  @default(false)
  author            String
  extracurricularId String
  institutionId     String
  createdById       String?
  // Status tampil di Event Board siswa (dashboard):
  // none (belum diajukan) → pending (diajukan operator, menunggu admin)
  // → approved (disetujui admin, tampil di event board) / rejected (ditolak)
  displayStatus String   @default("none") // none, pending, approved, rejected
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  extracurricular Extracurricular @relation(fields: [extracurricularId], references: [id])
  institution     Institution     @relation(fields: [institutionId], references: [id])
  createdBy       User?           @relation("NewsCreator", fields: [createdById], references: [id])

  @@map("news")
}

model Gallery {
  id                String   @id @default(cuid())
  title             String
  date              DateTime @default(now())
  color             String   @default("#4A9E9E")
  imageCount        Int      @default(0)
  extracurricularId String
  institutionId     String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  extracurricular Extracurricular @relation(fields: [extracurricularId], references: [id])
  institution     Institution     @relation(fields: [institutionId], references: [id])
  images          GalleryImage[]

  @@map("gallery")
}

model GalleryImage {
  id        String   @id @default(cuid())
  url       String
  galleryId String
  createdAt DateTime @default(now())

  gallery Gallery @relation(fields: [galleryId], references: [id])

  @@map("gallery_image")
}

model Achievement {
  id                String           @id @default(cuid())
  title             String
  description       String?
  date              DateTime         @default(now())
  type              AchievementType
  level             AchievementLevel
  proofUrl          String?
  studentId         String
  extracurricularId String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  student        Student         @relation(fields: [studentId], references: [id])
  extracurricular Extracurricular @relation(fields: [extracurricularId], references: [id])

  @@map("achievement")
}

model FeedPost {
  id                String        @id @default(cuid())
  type              FeedPostType
  title             String
  content           String
  author            String
  avatar            String?
  likesCount        Int           @default(0)
  image             String?
  date              DateTime      @default(now())
  extracurricularId String
  institutionId     String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  extracurricular Extracurricular @relation(fields: [extracurricularId], references: [id])
  institution     Institution     @relation(fields: [institutionId], references: [id])
  comments        FeedComment[]
  likes           FeedLike[]

  @@map("feed_post")
}

model FeedComment {
  id         String   @id @default(cuid())
  text       String
  userId     String
  feedPostId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id])
  feedPost FeedPost @relation(fields: [feedPostId], references: [id])

  @@map("feed_comment")
}

model FeedLike {
  id         String   @id @default(cuid())
  userId     String
  feedPostId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id])
  feedPost FeedPost @relation(fields: [feedPostId], references: [id])

  @@unique([userId, feedPostId])
  @@map("feed_like")
}

model UserPermission {
  id           String @id @default(cuid())
  permissionId String
  userId       String

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, permissionId])
  @@map("user_permission")
}

model ActivityLog {
  id            String   @id @default(cuid())
  action        String
  entityType    String?
  entityId      String?
  description   String?
  userId        String
  institutionId String
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id])
  institution Institution @relation(fields: [institutionId], references: [id])

  @@map("activity_log")
}

model Article {
  id                String   @id @default(cuid())
  title             String
  slug              String   @unique
  content           String
  excerpt           String?
  coverImage        String?
  category          String   @default("general")
  tags              String?
  status            String   @default("draft") // draft, published
  authorId          String
  // Operator ekskul: artikel otomatis terikat ke ekskul miliknya.
  extracurricularId String?
  institutionId     String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  author          User            @relation(fields: [authorId], references: [id])
  extracurricular Extracurricular? @relation(fields: [extracurricularId], references: [id])
  institution     Institution     @relation(fields: [institutionId], references: [id])
  views           ArticleView[]

  @@map("article")
}

model ArticleView {
  id        String   @id @default(cuid())
  articleId String
  userId    String
  viewedAt  DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([articleId, userId])
  @@index([articleId])
  @@map("article_view")
}

model ExtracurricularMaterial {
  id                String   @id @default(cuid())
  title             String
  description       String?
  fileUrl           String?
  fileType          String?  // pdf, doc, image, video, link
  content           String?  // untuk materi berupa teks
  extracurricularId String
  uploadedById      String
  institutionId     String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  extracurricular Extracurricular @relation(fields: [extracurricularId], references: [id])
  uploadedBy     User            @relation(fields: [uploadedById], references: [id])
  institution    Institution     @relation(fields: [institutionId], references: [id])

  @@map("extracurricular_material")
}

model Notification {
  id            String   @id @default(cuid())
  key           String   @unique // de-dupe: `${type}:${refId}:${userId}`
  userId        String
  institutionId String
  type          String // feed, achievement, schedule, poll, news
  title         String
  body          String?
  link          String?
  read          Boolean  @default(false)
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id])
  institution Institution @relation(fields: [institutionId], references: [id])

  @@map("notification")
}

model Agenda {
  id            String   @id @default(cuid())
  title         String
  description   String?
  date          DateTime
  timeStart     String
  timeEnd       String?
  color         String   @default("#4A9E9E")
  userId        String
  institutionId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User        @relation(fields: [userId], references: [id])
  institution Institution @relation(fields: [institutionId], references: [id])

  @@map("agenda")
}  // Kepengurusan / struktur organisasi ekskul. Setiap baris adalah satu jabatan
  // dengan nama pengurus, kelas, foto (opsional), dan urutan tampil (sortOrder).
  // Jabatan bebas/custom (contoh: Ketua, Wakil Ketua, Sekretaris, Bendahara, ...)
  model BoardPosition {
    id                String   @id @default(cuid())
    name              String
    // Kelas pengurus (contoh: XI IPA 1) — ditampilkan di kartu struktur.
    className         String?
    position          String
    photoUrl          String?
    sortOrder         Int      @default(0)
    extracurricularId String
    institutionId     String
    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt

    extracurricular Extracurricular @relation(fields: [extracurricularId], references: [id])
    institution     Institution     @relation(fields: [institutionId], references: [id])

    @@map("board_position")
  }
